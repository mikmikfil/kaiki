{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kaiki/kaiki",
    "type": "project",
    "description": "Kaiki \u2014 booking engine for cruises, day trips and private charters.",
    "keywords": [
        "laravel",
        "booking",
        "charter",
        "greece"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^3.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "spatie/laravel-data": "^4.23",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --force --ansi",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --exclude-group=mysql --exclude-group=chromium --exclude-group=external"
        ],
        "test:fast": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --group=fast"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest -c phpunit.coverage.xml --coverage --min=80 --exclude-group=mysql --exclude-group=chromium --exclude-group=external"
        ],
        "schema:snapshot": [
            "@php artisan schema:snapshot --ansi"
        ],
        "test:mysql": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --group=mysql"
        ],
        "test:tenancy": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --group=tenancy"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:test": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "stan": [
            "@composer analyse"
        ],
        "ci": [
            "@composer lint:test",
            "@composer analyse",
            "@composer test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Clean checkout to a running app: .env, key, SQLite file, migrate, seed, build assets.",
        "dev": "artisan serve + queue listener + Vite together.",
        "test": "Pest, excluding the mysql, chromium and external groups (ENV-15). The flag is repeated deliberately: Pest ignores a comma-separated --exclude-group.",
        "test:fast": "The fast group only. Used by the Stop hook.",
        "test:coverage": "The TST-1 gate: coverage of app/Domain only, failing under 80%. Needs PCOV, so CI only (ENV-22). The threshold lives here and nowhere else.",
        "schema:snapshot": "Regenerates database/schema/mysql-schema.snapshot.sql, the file the migrate-from-zero gate compares against (ENV-10). Needs a MySQL 8 connection - see docs/ci.md.",
        "test:mysql": "The mysql group. Needs a MySQL 8 instance; normally CI only.",
        "lint": "Pint in fix mode.",
        "lint:test": "Pint in check mode. What CI runs.",
        "analyse": "PHPStan level 6 with Larastan.",
        "stan": "Alias for analyse.",
        "ci": "lint:test, analyse, test - in that order, failing on the first.",
        "test:tenancy": "The cross-tenant isolation gate. A required CI check in its own right (ADR-0001)."
    }
}
