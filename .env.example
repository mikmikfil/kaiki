APP_NAME=Kaiki
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Storage is always UTC. Display timezone is per tenant (default Europe/Athens)
# and never comes from here. See docs/spec.md ENV-14 and CNV-2.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Local development runs on SQLite. MySQL 8 exists only in CI and production
# (docs/spec.md §13, ADR-0015). Do not point this at MySQL locally — the whole
# point of the split is that migrations are proven against both engines.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kaiki
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue and cache run on the database driver locally. Redis and Horizon exist
# only in CI and production (ADR-0015).
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is written to the log locally. Postmark is configured per environment.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Kaiki
# ---------------------------------------------------------------------------

# WordPress plugin end-to-end tests run against a real WordPress site, because
# there is no wp-env in this project (docs/spec.md WPP-15, ENV-3). Leave empty
# to skip the plugin suite.
KAIKI_WP_TEST_URL=

# Browsershot needs a Chromium binary for PDF rendering. Leave empty locally to
# skip the PDF snapshot group; CI provides one (docs/spec.md ENV-20).
KAIKI_CHROME_PATH=

# The host the guest-facing pages (/{operator-slug}) are served on. Unset, it
# is book.kaiki.test, which only loads with a hosts-file entry. Locally, run a
# second `php artisan serve --host=0.0.0.0 --port=8001` and set this to
# 127.0.0.1:8001 — or to the machine's LAN address to open the pages on a phone.
KAIKI_HOSTED_HOST=127.0.0.1:8001

# Where an operator's "upgrade plan" link goes when a plan limit stops them
# (docs/spec.md SAA-8): a contact page or a mailto: address. Empty means
# mailto: MAIL_FROM_ADDRESS. Becomes the billing screen once M7 builds one.
KAIKI_UPGRADE_URL=

# Payment gateways are operator-owned and stored encrypted per tenant. These
# are platform-level sandbox credentials for local and CI testing only —
# never production keys, never an operator's keys.
VIVA_SANDBOX_CLIENT_ID=
VIVA_SANDBOX_CLIENT_SECRET=
VIVA_SANDBOX_SOURCE_CODE=
STRIPE_SANDBOX_KEY=
STRIPE_SANDBOX_SECRET=
STRIPE_SANDBOX_WEBHOOK_SECRET=
