<?xml version="1.0" encoding="UTF-8"?>
<!--
    TST-1: the coverage gate covers app/Domain and nothing else. A whole-app
    threshold rewards writing tests for Filament resources instead of for the
    engine, which is the one part of this system that must not be wrong.

    Identical to phpunit.xml apart from the source filter. CiGatesTest asserts
    the two environment blocks stay identical, because a coverage run under a
    different environment measures something other than what CI runs.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Kept in step with phpunit.xml by `CiGatesTest`, which compares the
            two skeletons: a coverage config that ran a different set of tests
            would report a percentage for a suite nobody runs.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/Domain</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Gateway hosts, pinned to a domain that cannot resolve.

            RFC 6761 reserves `.test`, so a request that escapes `Http::fake()`
            fails immediately instead of reaching a real payment provider from a
            CI runner. `GatewayHostsTest` asserts every configured host ends in
            `.test` while `APP_ENV=testing`, which is the acceptance criterion
            in #82: no HTTP client is constructed with a real base URI in the
            test environment.

            Seven values because Viva splits accounts, api and checkout across
            two environments and Stripe has one host for both — the asymmetry is
            real and flattening it here would hide it.
        -->
        <env name="KAIKI_STRIPE_BASE_URI" value="https://api.stripe.test"/>
        <env name="KAIKI_VIVA_ACCOUNTS" value="https://accounts.viva.test"/>
        <env name="KAIKI_VIVA_API" value="https://api.viva.test"/>
        <env name="KAIKI_VIVA_CHECKOUT" value="https://www.viva.test"/>
        <env name="KAIKI_VIVA_DEMO_ACCOUNTS" value="https://demo-accounts.viva.test"/>
        <env name="KAIKI_VIVA_DEMO_API" value="https://demo-api.viva.test"/>
        <env name="KAIKI_VIVA_DEMO_CHECKOUT" value="https://demo.viva.test"/>
    </php>
</phpunit>
