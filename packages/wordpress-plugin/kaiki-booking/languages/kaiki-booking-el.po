msgid "%d trips"
msgstr "%d εκδρομές"

msgid "for 1 guest"
msgstr "για 1 άτομο"

msgid "for %d guests"
msgstr "για %d άτομα"

msgid "1 seat left"
msgstr "1 θέση ακόμη"

msgid "%d seats left"
msgstr "%d θέσεις ακόμη"

msgid "Trip search bar"
msgstr "Μπάρα αναζήτησης εκδρομών"

msgid "Results page"
msgstr "Σελίδα αποτελεσμάτων"

msgid "The page with the «Trip search results» widget. Empty: this same page."
msgstr "Η σελίδα με το widget «Αποτελέσματα αναζήτησης». Κενό: αυτή η ίδια σελίδα."

msgid "In one row"
msgstr "Σε μία σειρά"

msgid "One field under the other"
msgstr "Το ένα πεδίο κάτω από το άλλο"

msgid "Button text"
msgstr "Κείμενο κουμπιού"

msgid "Show type and port, if switched on in Kaiki"
msgstr "Τύπος και λιμάνι, αν είναι ενεργά στο Kaiki"

msgid "Bar"
msgstr "Μπάρα"

msgid "Field background"
msgstr "Φόντο πεδίων"

msgid "Field corner radius"
msgstr "Στρογγυλάδα πεδίων"

msgid "Button"
msgstr "Κουμπί"

msgid "Hover background"
msgstr "Φόντο στο πέρασμα"

msgid "Trip search results"
msgstr "Αποτελέσματα αναζήτησης"

msgid "Before anyone searches, this shows every trip. After a search: the trips for that date and party, with the price for the party."
msgstr "Πριν γίνει αναζήτηση δείχνει όλες τις εκδρομές. Μετά: τις εκδρομές για εκείνη τη μέρα και την παρέα, με την τιμή για την παρέα."

msgid "Result count colour"
msgstr "Χρώμα πλήθους αποτελεσμάτων"

# Shortcodes tab additions (2026-09-16).

msgid "cards, horizontal, overlay or minimal."
msgstr "cards, horizontal, overlay ή minimal."

msgid "yes or no: show the photo."
msgstr "yes ή no: φωτογραφία."

msgid "yes or no: show the label on the photo."
msgstr "yes ή no: ετικέτα πάνω στη φωτογραφία."

msgid "yes or no: show the price."
msgstr "yes ή no: τιμή."

msgid "Every boat that runs a published trip, with its numbers, amenities and trips."
msgstr "Κάθε σκάφος με δημοσιευμένη εκδρομή, με τα στοιχεία, τις παροχές και τις εκδρομές του."

msgid "rows, rows-left, grid, overlay or compact."
msgstr "rows, rows-left, grid, overlay ή compact."

msgid "yes or no: show the numbers."
msgstr "yes ή no: αριθμοί (επιβάτες, μήκος…)."

msgid "yes or no: show the amenities."
msgstr "yes ή no: παροχές."

msgid "yes or no: show the trips it runs."
msgstr "yes ή no: εκδρομές που κάνει."

msgid "Any detail Kaiki has about the trip, by its path."
msgstr "Οποιοδήποτε στοιχείο έχει το Kaiki για την εκδρομή, με τη διαδρομή του."

msgid "The path, e.g. vessel.name or meeting_point.instructions."
msgstr "Η διαδρομή, π.χ. vessel.name ή meeting_point.instructions."

msgid "text, list, html, url or image."
msgstr "text, list, html, url ή image."

msgid "Text before the value."
msgstr "Κείμενο πριν από την τιμή."

msgid "Text after the value."
msgstr "Κείμενο μετά την τιμή."

msgid "The search bar: date, guests, and type or port when switched on in Kaiki."
msgstr "Η μπάρα αναζήτησης: ημερομηνία, άτομα, και τύπος ή λιμάνι όταν είναι ενεργά στο Kaiki."

msgid "The address of the results page. Empty: the same page."
msgstr "Η διεύθυνση της σελίδας αποτελεσμάτων. Κενό: η ίδια σελίδα."

msgid "inline or stacked."
msgstr "inline ή stacked."

msgid "The button text."
msgstr "Το κείμενο του κουμπιού."

msgid "The trips for the searched date and party, with the price for the party. Every trip before a search."
msgstr "Οι εκδρομές για την ημερομηνία και την παρέα, με την τιμή για την παρέα. Πριν από αναζήτηση, όλες οι εκδρομές."

# Empty sections (2026-09-16).

msgid "Hide when Kaiki has nothing for it"
msgstr "Απόκρυψη όταν το Kaiki δεν έχει στοιχεία"

msgid "On a trip page, this section is left out when every Kaiki widget in it is empty — for example a trip with no itinerary. The editor always shows it."
msgstr "Σε σελίδα εκδρομής, η ενότητα δεν εμφανίζεται όταν όλα τα widgets του Kaiki μέσα της είναι άδεια — π.χ. εκδρομή χωρίς πρόγραμμα. Ο editor τη δείχνει πάντα."

msgid "+%d photos"
msgstr "+%d φωτογραφίες"
