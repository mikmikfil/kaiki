<?xml version="1.0"?>
<ruleset name="Kaiki Booking">
    <description>
        WPP-11: the WordPress coding standard, plus a PHP 8.1 compatibility check.

        The compatibility ruleset is the half that is easy to forget and expensive
        to miss: the platform is 8.4 and a developer writing this plugin has 8.4
        habits, so an enum in a property type or a `readonly` class would pass
        every other check here and fatal on the operator's host. `testVersion`
        below is what catches it, and it is the same 8.1 the plugin header
        declares.
    </description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Fail the build on a warning as well as an error. WordPress's own sniffs
         report most escaping and sanitising problems as warnings, and a warning
         nobody has to fix is a sniff that is not running. -->
    <config name="minimum_supported_wp_version" value="6.4"/>
    <arg name="severity" value="1"/>

    <rule ref="WordPress">
        <!-- The plugin is namespaced PSR-4 and autoloaded by Composer, so its
             files are `src/Settings/SettingsPage.php` rather than
             `class-settings-page.php`. WPP-1 fixes the autoloading; this sniff
             predates PSR-4 and cannot be satisfied alongside it. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.1-"/>

    <!-- Every prefix WPP-11 requires, checked rather than remembered. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="kaiki"/>
                <element value="Kaiki\Booking"/>
            </property>
        </properties>
    </rule>

    <!--
        The test bootstrap defines `get_option`, `set_transient` and friends: it
        stands in for WordPress so the plugin's arithmetic can be tested without
        it. Those doubles **cannot** be prefixed — a prefixed `kaiki_get_option`
        would not be the function the plugin calls — so the two sniffs about
        global names are switched off there and only there.

        Everything else still applies to the tests: escaping, formatting,
        documentation, and the PHP 8.1 compatibility check.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        And the documentation sniffs, in the tests only.

        A test method's name is its description — `test_a_stale_timestamp_is_
        refused` says more than a docblock above it would — and a docblock on
        every `setUp()` is noise that trains people to skim docblocks. The
        reasoning that matters in a test file is in the class docblock and beside
        the assertions, where it explains *why the case exists*, and no sniff can
        check for that.
    -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="Generic.Commenting.DocComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        The i18n sniff, in the tests only. The bootstrap *defines* `__()` and
        `esc_html__()` as stand-ins for WordPress's own, and a sniff that
        inspects their arguments is inspecting the stub's own parameters as if
        they were a translator call.
    -->
    <rule ref="WordPress.WP.I18n">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="kaiki-booking"/>
            </property>
        </properties>
    </rule>
</ruleset>
