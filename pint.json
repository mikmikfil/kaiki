{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "concat_space": {
            "spacing": "one"
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor"
    ],
    "notPath": [
        "packages/wordpress-plugin"
    ]
}
