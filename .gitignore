# Kaiki
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal
/public/widget
# The widget's build output and its workspace modules. The bundle is published
# by the release pipeline (ADR-0011), never committed — a checked-in artefact is
# one somebody edits by hand.
/packages/*/dist
/packages/*/node_modules
# The ENV-10 snapshot is committed as database/schema/*.snapshot.sql. A dump at
# either of Laravel's own schema paths would be loaded INSTEAD of running the
# migrations, so a stray one must never reach a commit. The .dump extension is
# the one MigrateCommand::schemaPath() checks FIRST, and the connection name is
# part of the filename, so this covers sqlite-schema.sql on a local machine too.
/database/schema/*-schema.sql
/database/schema/*-schema.dump
# Written by `composer test:coverage`; the figure belongs in CI, not in a commit.
/coverage.xml
/.claude/agent-memory
/.claude/settings.local.json


# The end-to-end run: a database it recreates, a key it mints, and its output.
/database/e2e.sqlite
/packages/widget/e2e/.state.json
/packages/widget/e2e/.results
/playwright-report

# The WordPress plugin brings its own dev dependencies; the release zip carries
# a production vendor/ built by the workflow, not this one. The lock file **is**
# committed, so the linter everybody runs is the same linter.
/packages/wordpress-plugin/kaiki-booking/vendor
