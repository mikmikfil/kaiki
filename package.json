{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "kaiki",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run build:panel",
        "build:panel": "node resources/css/filament/app/build.cjs",
        "dev:panel": "node resources/css/filament/app/build.cjs --watch",
        "dev": "vite",
        "test:js": "node --test \"tests/js/*.test.mjs\"",
        "widget:dev": "npm -w packages/widget run dev",
        "widget:build": "npm -w packages/widget run build",
        "widget:size": "npm -w packages/widget run size",
        "e2e": "playwright test",
        "e2e:smoke": "playwright test --project=smoke",
        "e2e:mobile": "playwright test --project=mobile",
        "e2e:install": "playwright install --with-deps chromium",
        "e2e:wp": "node -e \"console.log('e2e:wp — runs against KAIKI_WP_TEST_URL from .env; lands in M4. Stub.')\"",
        "plugin:lint": "composer --working-dir=packages/wordpress-plugin/kaiki-booking run lint",
        "plugin:lint:fix": "composer --working-dir=packages/wordpress-plugin/kaiki-booking run lint:fix",
        "plugin:test": "composer --working-dir=packages/wordpress-plugin/kaiki-booking run test",
        "plugin:zip": "node packages/wordpress-plugin/build-zip.mjs",
        "mjml:build": "node -e \"console.log('mjml:build — compiles email templates to committed HTML; lands in M2. Stub.')\"",
        "widget:guards": "npm -w packages/widget run guards",
        "widget:test": "npm -w packages/widget run test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.6.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "jsqr": "^1.4.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.5.28",
        "postcss-import": "^15.1.0",
        "puppeteer": "^25.10.0",
        "tailwindcss": "^4.0.0",
        "tailwindcss3": "npm:tailwindcss@^3.4.19",
        "vite": "^7.0.7"
    },
    "workspaces": [
        "packages/*"
    ]
}
