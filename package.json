{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "kaiki",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "widget:dev": "npm -w packages/widget run dev",
        "widget:build": "npm -w packages/widget run build",
        "widget:size": "npm -w packages/widget run size",
        "e2e": "playwright test",
        "e2e:smoke": "playwright test --project=smoke",
        "e2e:install": "playwright install --with-deps chromium",
        "e2e:wp": "node -e \"console.log('e2e:wp — runs against KAIKI_WP_TEST_URL from .env; lands in M4. Stub.')\"",
        "plugin:lint": "node -e \"console.log('plugin:lint — phpcs against the WordPress ruleset, PHP 8.1 target; lands in M4. Stub.')\"",
        "mjml:build": "node -e \"console.log('mjml:build — compiles email templates to committed HTML; lands in M2. Stub.')\"",
        "widget:guards": "npm -w packages/widget run guards",
        "widget:test": "npm -w packages/widget run test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "puppeteer": "^25.10.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "workspaces": [
        "packages/*"
    ]
}
